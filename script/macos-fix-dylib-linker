#!/usr/bin/env python3
"""Linker wrapper that works around macOS 27 dyld rejecting some proc-macro dylibs.

dyld on macOS 27 refuses to load a dylib whose LC_SYMTAB string table is not
8-byte aligned ("mis-aligned LINKEDIT string pool"). Both Apple ld and ld64.lld
emit a 4-byte aligned string table when the indirect symbol count is odd (for
example `sqlez_macros`), which later fails with
`error[E0463]: can't find crate for sqlez_macros`.

This wrapper runs the real linker (`cc`) and, for dylib outputs only, inserts
4 bytes of padding before the string table when needed, then re-signs the file.

Use it with:
    export CARGO_TARGET_AARCH64_APPLE_DARWIN_LINKER="$PWD/script/macos-fix-dylib-linker"
"""
import os
import struct
import subprocess
import sys

LC_SEGMENT_64 = 0x19
LC_SYMTAB = 0x2
LC_CODE_SIGNATURE = 0x1D
MH_MAGIC_64 = 0xFEEDFACF
# Load commands that carry a (offset, size) pair into __LINKEDIT at +8.
LINKEDIT_DATA_CMDS = {
    0x1D,  # LC_CODE_SIGNATURE
    0x1E,  # LC_SEGMENT_SPLIT_INFO
    0x26,  # LC_FUNCTION_STARTS
    0x29,  # LC_DATA_IN_CODE
    0x2B,  # LC_DYLIB_CODE_SIGN_DRS
    0x2E,  # LC_LINKER_OPTIMIZATION_HINT
    0x80000033,  # LC_DYLD_EXPORTS_TRIE
    0x80000034,  # LC_DYLD_CHAINED_FIXUPS
}


def fix(path):
    with open(path, "rb") as f:
        data = bytearray(f.read())
    if len(data) < 32 or struct.unpack_from("<I", data, 0)[0] != MH_MAGIC_64:
        return
    ncmds, sizeofcmds = struct.unpack_from("<II", data, 16)

    symtab = None
    linkedit = None
    has_sig = False
    offset = 32
    for _ in range(ncmds):
        cmd, cmdsize = struct.unpack_from("<II", data, offset)
        if cmd == LC_SYMTAB:
            symtab = offset
        elif cmd == LC_SEGMENT_64 and data[offset + 8 : offset + 24].rstrip(b"\0") == b"__LINKEDIT":
            linkedit = offset
        elif cmd == LC_CODE_SIGNATURE:
            has_sig = True
        offset += cmdsize
    if symtab is None or linkedit is None:
        return
    stroff = struct.unpack_from("<I", data, symtab + 16)[0]
    if stroff % 8 == 0:
        return

    if has_sig:
        subprocess.run(["codesign", "--remove-signature", path], check=True)
        with open(path, "rb") as f:
            data = bytearray(f.read())
        ncmds = struct.unpack_from("<I", data, 16)[0]

    # Re-read load commands after the signature was removed.
    symtab = linkedit = None
    offset = 32
    for _ in range(ncmds):
        cmd, cmdsize = struct.unpack_from("<II", data, offset)
        if cmd == LC_SYMTAB:
            symtab = offset
        elif cmd == LC_SEGMENT_64 and data[offset + 8 : offset + 24].rstrip(b"\0") == b"__LINKEDIT":
            linkedit = offset
        elif cmd in LINKEDIT_DATA_CMDS or cmd in (0x22, 0x80000022):
            # Anything located after the string table cannot be shifted safely.
            off = struct.unpack_from("<I", data, offset + 8)[0]
            if off >= stroff:
                sys.stderr.write("macos-fix-dylib-linker: data after strtab, skipping\n")
                return
        elif cmd == 0xB:  # LC_DYSYMTAB: indirect symbols precede strtab
            pass
        offset += cmdsize
    stroff = struct.unpack_from("<I", data, symtab + 16)[0]
    strsize = struct.unpack_from("<I", data, symtab + 20)[0]
    if stroff + strsize != len(data):
        sys.stderr.write("macos-fix-dylib-linker: unexpected data after strtab, skipping\n")
        return

    pad = 8 - stroff % 8
    data[stroff:stroff] = b"\0" * pad
    struct.pack_into("<I", data, symtab + 16, stroff + pad)
    vmsize, fileoff, filesize = struct.unpack_from("<QQQ", data, linkedit + 32)
    filesize += pad
    page = 0x4000
    vmsize = max(vmsize, (filesize + page - 1) // page * page)
    struct.pack_into("<QQQ", data, linkedit + 32, vmsize, fileoff, filesize)

    with open(path, "wb") as f:
        f.write(data)
    subprocess.run(["codesign", "--force", "-s", "-", path], check=True)


def main():
    args = sys.argv[1:]
    result = subprocess.run(["cc"] + args)
    if result.returncode != 0:
        sys.exit(result.returncode)
    if "-dynamiclib" in args and "-o" in args:
        out = args[args.index("-o") + 1]
        if os.path.isfile(out):
            fix(out)


if __name__ == "__main__":
    main()
